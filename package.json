{
  "name": "drawora",
  "version": "1.0.0",
  "description": "Free, open-source browser whiteboard for teaching, notes, drawing, and real-time collaboration. Offline PWA with export, presentation mode, and Cloudflare Pages support.",
  "repository": {
    "type": "git",
    "url": "https://github.com/pradipNP/drawora.git"
  },
  "bugs": {
    "url": "https://github.com/pradipNP/drawora/issues"
  },
  "homepage": "https://github.com/pradipNP/drawora#readme",
  "main": "js/app.js",
  "scripts": {
    "start": "npx serve .",
    "pages:dev": "npx wrangler pages dev .",
    "pages:deploy": "npx wrangler pages deploy ."
  },
  "keywords": [
    "whiteboard",
    "digital-whiteboard",
    "canvas",
    "drawing",
    "collaboration",
    "teaching",
    "education",
    "presentation",
    "pwa",
    "offline-first",
    "notes",
    "open-source",
    "cloudflare-pages",
    "vanilla-js"
  ],
  "author": "Drawora",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^3.109.2"
  }
}
